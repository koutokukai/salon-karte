DATABASE_URL="file:./prisma/dev.db"
# Turso 本番用（Vercel の環境変数に設定）
# TURSO_DATABASE_URL="libsql://xxxx.turso.io"
# TURSO_AUTH_TOKEN=""
AUTH_SECRET="dev-secret-change-me-please-32chars-min"

# ── Instagram 自動投稿 ──
# 対象アカウント。Instagram ログイン方式なら未設定でよい（"me" が使われる）
IG_USER_ID=""
# 長期アクセストークン（初回のみ。以降は app_settings に保存され自動更新される）
IG_ACCESS_TOKEN=""
# 画像の公開URLを組み立てるためのベースURL（Vercel では自動で入るので省略可）
SITE_URL=""
# Vercel Cron からの呼び出しを検証する共有シークレット
CRON_SECRET=""
# Facebookページ経由（システムユーザーの無期限トークン）を使う場合
# IG_API_BASE="https://graph.facebook.com/v21.0"
# IG_TOKEN_PERMANENT="true"
# 短命トークンを60日トークンに交換するときだけ必要（/api/instagram/exchange）
IG_APP_SECRET=""
